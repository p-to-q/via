{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-to-q/via/schemas/route-spec.schema.json",
  "title": "RouteSpec",
  "type": "object",
  "required": ["schemaVersion", "destination", "routes", "graph"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "destination": { "type": "string", "minLength": 1, "maxLength": 72 },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/route" }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 18,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "minItems": 4,
          "maxItems": 28,
          "items": { "$ref": "#/$defs/edge" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "route": {
      "type": "object",
      "required": ["id", "label", "color", "recommended", "tokens", "minutes", "gates", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 22 },
        "color": { "enum": ["lime", "amber", "violet"] },
        "recommended": { "type": "boolean" },
        "tokens": { "$ref": "#/$defs/range" },
        "minutes": { "$ref": "#/$defs/range" },
        "gates": { "type": "integer", "minimum": 0, "maximum": 9 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 54 }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "column", "lane"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "column": { "type": "integer", "minimum": 0, "maximum": 9 },
        "lane": { "type": "integer", "minimum": 0, "maximum": 4 },
        "gate": { "enum": ["green", "yellow", "red"] }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "routes"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "kind": { "enum": ["main", "branch"] }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
