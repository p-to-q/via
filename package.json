{
  "name": "@afkv/via",
  "version": "0.3.9",
  "description": "A Git-tree/Google Map interface for vibe coding decisions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "scripts/",
    "skills/",
    "examples/",
    "assets/",
    "docs/design-system.md",
    "docs/product-architecture.md",
    "docs/skill-landscape.md",
    "docs/agent-surfaces.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "via": "scripts/via.mjs"
  },
  "scripts": {
    "render:example": "node skills/via-route/scripts/render-route.mjs examples/web-coder-route.json assets/web-coder-route.svg",
    "validate:example": "node skills/via-route/scripts/validate-route.mjs examples/web-coder-route.json",
    "build:example": "node scripts/via.mjs build examples/web-coder-route.json --out example-output",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run validate:example && npm run build:example && npm pack --dry-run"
  },
  "keywords": [
    "agent",
    "skill",
    "planning",
    "route-map",
    "token-budget"
  ],
  "homepage": "https://github.com/p-to-q/via#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-to-q/via.git"
  },
  "bugs": {
    "url": "https://github.com/p-to-q/via/issues"
  },
  "author": "[p → q]",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
